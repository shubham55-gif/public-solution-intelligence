# ==============================================================================
# Public Solution Intelligence — Root Environment Template
# Technathon 2026 | PS12 Community Public-Space Safety Intelligence | Team W
# ==============================================================================
#
# Copy relevant environment variables to backend/.env and frontend/.env as needed.
# NEVER commit real credentials, passwords, or production secrets into version control.

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# PostgreSQL connection string:
# postgresql+psycopg://<USERNAME>:<PASSWORD>@localhost:5432/public_solution_intelligence
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/public_solution_intelligence

# Directory for report evidence storage (logical paths stored in DB)
UPLOADS_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880

# CORS origins for web dashboard access
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# JWT Security
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_EXPIRE_MINUTES=10080

# Intelligence / Analysis Engine Thresholds
DUPLICATE_SPATIAL_THRESHOLD_METERS=50
DUPLICATE_TEMPORAL_THRESHOLD_HOURS=24
HOTSPOT_DBSCAN_RADIUS_METERS=75
HOTSPOT_DBSCAN_MIN_SAMPLES=3
TEMPORAL_ANALYSIS_WINDOW_DAYS=7
RECURRENCE_PERIOD_DAYS=7
TREND_PERIOD_DAYS=7

# Local LLM / VLM (llama.cpp) Settings
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL_NAME=Qwen2.5-3B-Instruct-GGUF:Q4_K_M

VLM_ENABLED=false
VLM_BASE_URL=http://127.0.0.1:8082/v1
VLM_MODEL_NAME=Qwen2.5-VL-3B-Instruct-GGUF:Q4_K_M

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEVELOPMENT_USER_ID=<authority-user-uuid>
