<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="2dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Colored top strip by issue type -->
        <View
            android:id="@+id/viewTypeStrip"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/primaryBlue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- Issue icon -->
            <TextView
                android:id="@+id/tvIssueIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:text="🚧"
                android:textSize="22sp"
                android:gravity="center"
                android:background="@drawable/bg_icon_circle_blue"
                android:layout_marginEnd="12dp" />

            <!-- Main content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvIssue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Issue Type"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="3dp">

                    <TextView
                        android:id="@+id/tvWardLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Area"
                        android:textSize="12sp"
                        android:textColor="@color/textHint" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTimeAgo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="just now"
                    android:textSize="11sp"
                    android:textColor="@color/textHint"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Status chip + action -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/statusPending"
                    android:background="@drawable/bg_status_pending"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUpdateStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Update"
                    android:textSize="11sp"
                    app:backgroundTint="@color/adminPrimary"
                    app:cornerRadius="8dp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Risk/Repeat bar (admin only) -->
        <LinearLayout
            android:id="@+id/layoutRiskBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvRiskBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔴 High Risk"
                android:textSize="11sp"
                android:textColor="@color/riskHigh"
                android:background="@drawable/bg_risk_high"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvRepeatBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ Repeated"
                android:textSize="11sp"
                android:textColor="#6A1B9A"
                android:background="@drawable/bg_repeat_badge"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:visibility="gone" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>

