<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header: Avatar & Citizen Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvAvatar"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:text="👤"
                android:textSize="26sp"
                android:gravity="center"
                android:background="@drawable/bg_step_circle_green"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Citizen Name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/textPrimary" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="citizen@example.com"
                    android:textSize="13sp"
                    android:textColor="@color/textSecondary"
                    android:layout_marginTop="2dp" />

                <TextView
                    android:id="@+id/tvProfilePhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="12sp"
                    android:textColor="@color/textHint"
                    android:visibility="gone"
                    android:layout_marginTop="1dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp" />

        <!-- Select Language Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_language"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/citizenPrimary"
            android:layout_marginBottom="10dp" />

        <RadioGroup
            android:id="@+id/rgLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbEnglish"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/lang_english"
                android:textSize="14sp"
                android:textColor="@color/textPrimary"
                android:buttonTint="@color/citizenPrimary"
                android:paddingStart="8dp" />

            <RadioButton
                android:id="@+id/rbMarathi"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/lang_marathi"
                android:textSize="14sp"
                android:textColor="@color/textPrimary"
                android:buttonTint="@color/citizenPrimary"
                android:paddingStart="8dp" />

            <RadioButton
                android:id="@+id/rbHindi"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/lang_hindi"
                android:textSize="14sp"
                android:textColor="@color/textPrimary"
                android:buttonTint="@color/citizenPrimary"
                android:paddingStart="8dp" />
        </RadioGroup>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="16dp" />

        <!-- Logout Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_logout"
            android:textSize="14sp"
            android:textStyle="bold"
            app:strokeColor="#C62828"
            app:strokeWidth="1.5dp"
            android:textColor="#C62828"
            app:cornerRadius="10dp"
            app:icon="@android:drawable/ic_lock_power_off"
            app:iconTint="#C62828"
            app:iconGravity="textStart"
            android:layout_marginBottom="10dp" />

        <!-- Close Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnProfileClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="@string/btn_close"
            android:textSize="13sp"
            android:textColor="@color/textSecondary" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
