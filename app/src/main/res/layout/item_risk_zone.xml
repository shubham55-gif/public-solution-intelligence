<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginTop="6dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Risk dot indicator -->
        <View
            android:id="@+id/viewRiskDot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bg_dot_risk_high"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWardName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ward Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/textPrimary" />

            <TextView
                android:id="@+id/tvComplaintCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 complaints"
                android:textSize="13sp"
                android:textColor="@color/textHint" />
        </LinearLayout>

        <!-- Risk badge -->
        <TextView
            android:id="@+id/tvRiskLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIGH"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/riskHigh"
            android:background="@drawable/bg_risk_high"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
