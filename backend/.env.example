# Comma-separated browser origins permitted by CORS.
# Android native clients are not restricted by browser CORS, but these local
# origins support a future React dashboard during development.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL connection string. Replace USERNAME and PASSWORD only in your
# local environment; never commit real credentials.
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@localhost:5432/public_solution_intelligence

# Optional filesystem location for report images. PostgreSQL stores only a
# logical uploads/reports/... reference, never the image bytes.
UPLOADS_DIR=uploads
MAX_IMAGE_SIZE_BYTES=5242880

# Deterministic related-report analysis thresholds.
DUPLICATE_SPATIAL_THRESHOLD_METERS=50
DUPLICATE_TEMPORAL_THRESHOLD_HOURS=24

# DBSCAN geographic hotspot detection parameters.
HOTSPOT_DBSCAN_RADIUS_METERS=75
HOTSPOT_DBSCAN_MIN_SAMPLES=3

# Temporal analysis defaults and UTC grouping boundaries.
TEMPORAL_ANALYSIS_WINDOW_DAYS=7
TEMPORAL_MORNING_START_HOUR=6
TEMPORAL_AFTERNOON_START_HOUR=12
TEMPORAL_EVENING_START_HOUR=17
TEMPORAL_NIGHT_START_HOUR=22

# Recurrence analysis defaults.
RECURRENCE_PERIOD_DAYS=7
RECURRENCE_ANALYSIS_WINDOW_DAYS=28

# Trend analysis defaults.
TREND_PERIOD_DAYS=7
TREND_ANALYSIS_WINDOW_DAYS=28

# Local llama.cpp server settings.
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:8081/v1
LLM_MODEL_NAME=Qwen2.5-3B-Instruct-GGUF:Q4_K_M
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=256
LLM_TIMEOUT_SECONDS=30

# Local llama.cpp multimodal VLM settings.
VLM_ENABLED=false
VLM_BASE_URL=http://127.0.0.1:8082/v1
VLM_MODEL_NAME=Qwen2.5-VL-3B-Instruct-GGUF:Q4_K_M
VLM_TEMPERATURE=0.1
VLM_MAX_TOKENS=128
VLM_TIMEOUT_SECONDS=30
